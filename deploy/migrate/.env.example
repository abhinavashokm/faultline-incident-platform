# Migrate service environment – used by `docker compose run --rm migrate`
# These point to the postgres container (service name: postgres).

CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://faultline:faultline@postgres:5432/control_plane
PROCESSING_DATABASE_URL=postgresql+asyncpg://faultline:faultline@postgres:5432/processing

# Required by control-plane settings validation; value is not used during migration.
CONTROL_PLANE_INTERNAL_SERVICE_SECRET=placeholder-migrate-only
