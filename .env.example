# ── Compose profiles ──────────────────────────────────────────────────────────
# Set to backend,frontend to start all services with `docker compose up -d`.
# Unset or set to empty string to start infra only.
COMPOSE_PROFILES=backend,frontend

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=faultline
POSTGRES_PASSWORD=faultline

# ── Shared internal service secret ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be identical for control-plane and ingestion
INTERNAL_SERVICE_SECRET=change-me

# ── Control Plane ─────────────────────────────────────────────────────────────
CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://faultline:faultline@postgres:5432/control_plane
CONTROL_PLANE_INTERNAL_SERVICE_SECRET=change-me
CONTROL_PLANE_JWT_PRIVATE_KEY_PATH=keys/private.pem
CONTROL_PLANE_JWT_PUBLIC_KEY_PATH=keys/public.pem
CONTROL_PLANE_JWT_KEY_ID=dev-1
CONTROL_PLANE_SMTP_HOST=mailpit
CONTROL_PLANE_SMTP_PORT=1025
CONTROL_PLANE_OTP_HMAC_SECRET=change-me-otp-secret

# ── Ingestion ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://redis:6379/0
CONTROL_PLANE_SERVICE_TOKEN=change-me
CONTROL_PLANE_INTERNAL_URL=http://control-plane:8000

# ── Processing ────────────────────────────────────────────────────────────────
PROCESSING_DATABASE_URL=postgresql+asyncpg://faultline:faultline@postgres:5432/processing
PROCESSING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PROCESSING_AUTH_PROVIDER=jwks
PROCESSING_AUTH_JWKS_URL=http://control-plane:8000/.well-known/jwks.json

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
