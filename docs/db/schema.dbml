Project ErrorTrackingPlatform {
  database_type: 'PostgreSQL'
  Note: 'Logical data model for a microservices-based error tracking and incident response platform. Each service owns its schema and data. Services with a DB: control, processing, alerting, incidents, investigation.'
}

// =====================================================
// 1. CONTROL PLANE SERVICE
// Owns users, workspaces, workspace memberships,
// projects, credentials, releases and deployments
// =====================================================

Table control.users {
  id uuid [pk]  // generate UUIDv7 in the app for index-friendly ordering
  email citext [unique, not null]
  password_hash varchar  // not null if no social login
  full_name varchar(255) [not null]
  status varchar(20) [not null, default: 'active']  // CHECK in ('active','suspended','deleted')
  email_verified_at timestamptz
  password_changed_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table control.workspaces {
  id uuid [pk]
  name varchar(150) [not null]
  slug varchar(100) [not null, unique]  // CHECK slug format
  status varchar(20) [not null, default: 'active']  // CHECK active|suspended|deleted
  created_by uuid [not null]  // ON DELETE RESTRICT
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table control.workspace_members {
  id uuid [pk]
  workspace_id uuid [not null]  // ON DELETE CASCADE
  user_id uuid [not null]
  role varchar(20) [not null]  // CHECK owner|admin|member|viewer, no default
  invited_by uuid [ref: > control.users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, user_id) [unique]
    user_id
  }
}

Table control.projects {
  id uuid [pk]
  workspace_id uuid [not null]  // ON DELETE CASCADE
  name varchar(150) [not null]
  slug varchar(100) [not null]  // CHECK slug format, immutable
  description text
  platform varchar(30)  // optional: python | fastapi | django
  status varchar(20) [not null, default: 'active']  // CHECK active|archived
  archived_at timestamptz
  created_by uuid [not null]  // ON DELETE RESTRICT
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, slug) [unique]
    (workspace_id, id) [unique]  // target for composite child FKs
  }
}

Table control.project_api_keys {
  id uuid [pk]
  workspace_id uuid [not null]
  project_id uuid [not null]
  key_type varchar(20) [not null]  // CHECK ingest|release
  key_hash char(64) [not null, unique]  // sha256 hex of the full key
  key_prefix varchar(16) [not null]
  public_key varchar(64) [unique]  // only for ingest keys, re-displayable in the DSN
  name varchar(100)
  last_used_at timestamptz  // flushed from Redis, not updated per event
  expires_at timestamptz
  revoked_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    project_id
  }
}

Table control.project_settings {
  id uuid [pk]
  workspace_id uuid [not null]
  project_id uuid [not null, unique]  // one settings row per project

  // Platform guardrails (admin-only, clamp to hard maximums in the service layer)
  rate_limit_per_minute int [not null, default: 600]  // CHECK > 0
  max_payload_bytes int [not null, default: 200000]  // CHECK > 0

  // Project preferences (user-editable)
  retention_days int [not null, default: 30]  // CHECK > 0
  ignored_status_codes int[]  // e.g. {400,401,403,404}
  scrub_fields text[]  // extra keys to redact, beyond the defaults

  // Sampling (advanced, user can lower it, you cap how far)
  error_sample_rate numeric(5,4) [not null, default: 1.0]  // CHECK between 0 and 1
  performance_sample_rate numeric(5,4) [not null, default: 1.0]  // CHECK between 0 and 1

  version int [not null, default: 1]  // increment on every change, used for cache invalidation
  updated_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table control.releases {
  id uuid [pk]
  workspace_id uuid [not null]
  project_id uuid [not null]
  version varchar(150) [not null]  // CHECK not empty, no whitespace
  commit_sha varchar(64)  // CHECK lowercase hex, null for manual releases
  artifact_ref varchar(300)  // optional: image tag or digest used by rollback
  created_by_key_id uuid [not null, note: 'Release API key that created this release via CI. Null for releases created by a user in the dashboard.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, version) [unique]
    (workspace_id, project_id, id) [unique]  // target for deployments' composite ref
    (project_id, created_at)
    (project_id, commit_sha)
  }
}
// CHECK: exactly one of created_by / created_by_key_id is not null

Table control.deployments {
  id uuid [pk]
  workspace_id uuid [not null]
  project_id uuid [not null]
  release_id uuid [not null]
  environment varchar(100) [not null]  // CHECK lowercase ^[a-z0-9_-]+$
  kind varchar(20) [not null, default: 'deploy']  // CHECK deploy|rollback
  status varchar(30) [not null, default: 'pending']  // CHECK pending|running|success|failed|cancelled|rolled_back
  rollback_of_deployment_id uuid  // set when kind = rollback
  external_run_id varchar(100)  // GitHub Actions run id, for idempotency
  deployed_by uuid  // human (e.g. approved rollback)
  deployed_by_key_id uuid  // CI release key
  failure_reason varchar(500)
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  finished_at timestamptz  // CHECK finished_at >= started_at

  indexes {
    (project_id, environment, created_at)
    (project_id, external_run_id) [unique]
    (project_id, environment) [unique, note: 'partial: where status in (pending, running)']
  }
}
// CHECK: exactly one of deployed_by / deployed_by_key_id is not null

// added for refresh sessions
Table control.refresh_sessions {
  id uuid [pk]
  user_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  revoked_reason varchar(30)  // CHECK logout|reuse_detected|user_disabled

  indexes {
    user_id
  }
}

Table control.refresh_tokens {
  id uuid [pk]
  session_id uuid [not null]
  token_hash char(64) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  used_at timestamptz

  indexes {
    session_id
  }
}

// =====================================================
// RELATIONSHIPS
// All foreign keys belong to the Control Plane DB
// =====================================================

Ref: control.workspaces.created_by > control.users.id

Ref: control.workspace_members.workspace_id > control.workspaces.id
Ref: control.workspace_members.user_id > control.users.id

Ref: control.projects.workspace_id > control.workspaces.id
Ref: control.projects.created_by > control.users.id

Ref: control.project_api_keys.created_by > control.users.id
Ref: control.project_api_keys.project_id > control.projects.id 

// Replaces the simple project_settings.project_id ref
Ref: control.project_settings.(workspace_id, project_id) > control.projects.(workspace_id, id)
Ref: control.project_settings.updated_by > control.users.id

Ref: control.releases.(workspace_id, project_id) > control.projects.(workspace_id, id)
Ref: control.releases.created_by_key_id > control.project_api_keys.id

Ref: control.deployments.(workspace_id, project_id) > control.projects.(workspace_id, id)
Ref: control.deployments.(workspace_id, project_id, release_id) > control.releases.(workspace_id, project_id, id)
Ref: control.deployments.rollback_of_deployment_id > control.deployments.id
Ref: control.deployments.deployed_by_key_id > control.project_api_keys.id
Ref: control.deployments.deployed_by > control.users.id

Ref: control.refresh_sessions.user_id > control.users.id [delete: cascade]
Ref: control.refresh_tokens.session_id > control.refresh_sessions.id [delete: cascade]

// =====================================================
// 2. PROCESSING SERVICE
// (merged: Error Processing + Performance & Regression)
// Owns error events, fingerprints, grouped issues,
// aggregated endpoint metrics and regression records
// =====================================================

Table processing.issues {
  id uuid [pk]
  workspace_id uuid [not null]
  project_id uuid [not null]  // opaque ID, no cross-service FK
  fingerprint char(64) [not null]
  fingerprint_version smallint [not null, default: 1]  // which fingerprint algorithm version made this hash
  title varchar(500) [not null]
  exception_type varchar(255)
  culprit varchar(255)  // where it happened (top in-app frame or route), display only
  level varchar(20) [not null, default: 'error']  // CHECK error|warning|fatal
  status varchar(20) [not null, default: 'unresolved']  // CHECK unresolved|resolved|ignored
  first_seen_at timestamptz [not null]  // LEAST(...) on update
  last_seen_at timestamptz [not null]  // GREATEST(...) on update
  occurrence_count bigint [not null, default: 0]  // +1 only when the event insert succeeded
  affected_users_count bigint [not null, default: 0]  // +1 only when the issue_affected_users insert succeeded
  first_release varchar(150)  // release string from telemetry, not an FK
  last_release varchar(150)
  resolved_at timestamptz
  resolved_in_release varchar(150)
  resolved_by uuid  // opaque user id
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, fingerprint) [unique]
    (project_id, id) [unique]
    (project_id, status, last_seen_at)
    (project_id, first_seen_at)
  }
}

Table processing.error_events {
  id uuid [pk]  // SDK-generated event_id, also the dedup key
  workspace_id uuid [not null]
  project_id uuid [not null]  // opaque ID, no cross-service FK
  issue_id uuid [not null]
  fingerprint char(64) [not null]
  event_type varchar(20) [not null, default: 'error']  // CHECK error|message
  level varchar(20) [not null, default: 'error']  // CHECK error|warning|fatal
  exception_type varchar(255)
  message varchar(2000)  // scrubbed and truncated
  stack_frames jsonb  // structured frames: file, function, line, in_app
  service varchar(100)
  route_template varchar(500)  // normalized, e.g. /users/{id}
  http_method varchar(10)
  status_code smallint
  environment varchar(100)  // lowercase, must match deployments.environment
  release varchar(150)  // release string from telemetry, not an FK
  user_hash char(64)  // hash of the anonymized user id
  context jsonb  // request context and breadcrumbs, size-capped
  occurred_at timestamptz [not null]  // from the SDK clock
  received_at timestamptz [not null, default: `now()`]  // server receipt time

  indexes {
    (issue_id, occurred_at)
    (project_id, occurred_at)
  }
}

Ref: processing.error_events.issue_id > processing.issues.id
Ref: processing.error_events.(project_id, issue_id) > processing.issues.(project_id, id)

// ---- performance & regression tables (stores aggregated endpoint metrics, not every request) ----

Table processing.metric_buckets {
  workspace_id uuid [not null]
  project_id uuid [not null]  // opaque ID, no cross-service FK
  environment varchar(100) [not null]  // lowercase, matches deployments.environment
  service varchar(100) [not null, default: '']
  route_template varchar(500) [not null]  // normalized, e.g. /users/{id}; overflow goes to __other__
  http_method varchar(10) [not null]
  release varchar(150) [not null, default: 'unknown']  // release string from telemetry, not an FK
  bucket_start timestamptz [not null]  // fixed 1-minute width, truncated in UTC

  request_count bigint [not null, default: 0]  // scaled by 1/sample_rate if sampling
  error_count bigint [not null, default: 0]
  status_counts jsonb  // e.g. {"200": 950, "500": 12}
  latency_histogram bigint[] [not null]  // counts per fixed boundary, same boundaries on every row
  histogram_version smallint [not null, default: 1]
  latency_sum_ms "double precision" [not null, default: 0]
  min_latency_ms numeric(12,3)
  max_latency_ms numeric(12,3)

  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, environment, service, route_template, http_method, release, bucket_start) [pk]
    (project_id, release, environment, bucket_start)  // release comparison for regressions
    (project_id, bucket_start)  // dashboards and retention cleanup
  }
}

Table processing.processed_batches {
  batch_id uuid [pk]  // SDK-generated, makes redelivered batches a no-op
  workspace_id uuid [not null]
  project_id uuid [not null]
  processed_at timestamptz [not null, default: `now()`]

  indexes {
    processed_at  // for the cleanup job
  }
}

Table processing.regression_records {
  id uuid [pk]
  project_id uuid [not null]
  endpoint varchar(500) [not null]
  http_method varchar(10) [not null]
  environment varchar(100) [not null]
  baseline_release_id uuid
  detected_release_id uuid
  metric_name varchar(100) [not null]
  baseline_value numeric(14,4)
  observed_value numeric(14,4)
  change_percent numeric(10,2)
  status varchar [not null, default: 'active']
  detected_at timestamp [not null, default: `now()`]
  resolved_at timestamp
  evidence jsonb
}

// =====================================================
// 3. ALERTING SERVICE
// (merged: Alert + Notification)
// Owns alert rules, active/resolved alert states,
// notification channels, delivery jobs, results and retry history
// =====================================================

Table alerting.alert_rules {
  id uuid [pk]
  project_id uuid [not null]
  name varchar(150) [not null]
  rule_type varchar(50) [not null]
  conditions jsonb [not null]
  recovery_conditions jsonb
  severity varchar(30) [not null, default: 'warning']
  environment varchar(100)
  enabled boolean [not null, default: true]
  minimum_event_count int
  window_seconds int
  cooldown_seconds int
  created_by uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table alerting.alert_states {
  id uuid [pk]
  project_id uuid [not null]
  rule_id uuid [not null]
  deduplication_key varchar(255) [not null]
  status varchar(30) [not null, default: 'normal']
  first_triggered_at timestamp
  last_triggered_at timestamp
  last_evaluated_at timestamp
  updated_at timestamp

  indexes {
    (rule_id, deduplication_key) [unique]
    (project_id, status)
  }
}

Table alerting.alerts {
  id uuid [pk]
  project_id uuid [not null]
  rule_id uuid [not null]
  state_id uuid [not null]
  title varchar(255) [not null]
  severity varchar(30) [not null, default: 'warning']
  status varchar(30) [not null, default: 'firing']
  occurrence_count bigint [not null, default: 1]
  first_triggered_at timestamp [not null]
  last_triggered_at timestamp [not null]
  acknowledged_by uuid
  acknowledged_at timestamp
  recovered_at timestamp
  details jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (project_id, status, last_triggered_at)
    (state_id)
  }
}

Ref: alerting.alert_states.rule_id > alerting.alert_rules.id
Ref: alerting.alerts.rule_id > alerting.alert_rules.id
Ref: alerting.alerts.state_id > alerting.alert_states.id

// ---- notification tables ----

Table alerting.notification_channels {
  id uuid [pk]
  project_id uuid [not null]
  name varchar(150) [not null]
  channel_type varchar(30) [not null]
  destination text [not null]
  credentials_encrypted text
  secret_reference varchar(255)
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table alerting.alert_rule_channels {
  id uuid [pk]
  rule_id uuid [not null, note: 'Now same service as alert_rules, so a real FK']
  channel_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (rule_id, channel_id) [unique]
  }
}

Ref: alerting.alert_rule_channels.rule_id > alerting.alert_rules.id
Ref: alerting.alert_rule_channels.channel_id > alerting.notification_channels.id

Table alerting.deliveries {
  id uuid [pk]
  project_id uuid [not null]
  alert_id uuid [not null]
  channel_id uuid [not null]
  idempotency_key varchar(255) [not null, unique]
  status varchar [not null, default: 'pending']
  attempt_count int [not null, default: 0]
  next_attempt_at timestamp
  delivered_at timestamp
  last_error text
  payload jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table alerting.delivery_attempts {
  id uuid [pk]
  delivery_id uuid [not null]
  attempt_number int [not null]
  status varchar [not null]
  http_status_code int
  response_summary text
  error_message text
  started_at timestamp [not null, default: `now()`]
  finished_at timestamp

  indexes {
    (delivery_id, attempt_number) [unique]
  }
}

Ref: alerting.deliveries.alert_id > alerting.alerts.id  // same service now, real FK
Ref: alerting.deliveries.channel_id > alerting.notification_channels.id
Ref: alerting.delivery_attempts.delivery_id > alerting.deliveries.id


// =====================================================
// 4. INCIDENT SERVICE
// Owns incident lifecycle, related evidence and timeline
// =====================================================

Table incidents.incidents {
  id uuid [pk]
  workspace_id uuid [not null]
  title varchar(255) [not null]
  description text
  severity varchar(30) [not null, default: 'medium']
  status varchar(30) [not null, default: 'open']
  created_by uuid [not null]
  assigned_to uuid
  started_at timestamp [not null, default: `now()`]
  resolved_at timestamp
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Table incidents.incident_issues {
  id uuid [pk]
  incident_id uuid [not null]
  issue_id uuid [not null]
  issue_title varchar(255)
  error_type varchar(255)
  error_message text
  first_seen_at timestamp
  last_seen_at timestamp
  occurrence_count bigint
  snapshot_at timestamp [not null, default: `now()`]

  indexes {
    (incident_id, issue_id) [unique]
  }
}

Table incidents.incident_alerts {
  id uuid [pk]
  incident_id uuid [not null]
  alert_id uuid [not null]
  alert_title varchar(255)
  severity varchar(30)
  status varchar(30)
  triggered_at timestamp
  snapshot_at timestamp [not null, default: `now()`]

  indexes {
    (incident_id, alert_id) [unique]
  }
}

Table incidents.incident_timeline {
  id uuid [pk]
  incident_id uuid [not null]
  actor_id uuid
  event_type varchar(50) [not null]
  message text [not null]
  metadata jsonb
  created_at timestamp [not null, default: `now()`]

  indexes {
    (incident_id, created_at)
  }
}

Ref: incidents.incident_issues.incident_id > incidents.incidents.id
Ref: incidents.incident_alerts.incident_id > incidents.incidents.id
Ref: incidents.incident_timeline.incident_id > incidents.incidents.id


// =====================================================
// 5. INVESTIGATION / AI SERVICE
// Owns investigations, evidence references, and reports
// =====================================================

Table investigation.investigations {
  id uuid [pk]
  project_id uuid [not null]
  incident_id uuid
  status varchar [not null, default: 'pending']
  trigger_type varchar(50) [not null]
  question text
  summary text
  likely_cause text
  confidence_label varchar(30)
  model_name varchar(100)
  started_at timestamp
  completed_at timestamp
  error_message text
  created_at timestamp [not null, default: `now()`]
}

Table investigation.evidence {
  id uuid [pk]
  investigation_id uuid [not null]
  source_type varchar(50) [not null]
  source_record_id uuid
  source_reference text
  evidence_summary text
  relevance_score numeric(6,4)
  collected_at timestamp [not null, default: `now()`]
  metadata jsonb
}

Table investigation.recommendations {
  id uuid [pk]
  investigation_id uuid [not null]
  description text [not null]
  rationale text
  priority varchar(30)
  status varchar [not null, default: 'proposed']
  requires_approval boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table investigation.knowledge_documents {
  id uuid [pk]
  project_id uuid
  title varchar(255) [not null]
  source_type varchar(50) [not null]
  source_uri text
  content_hash varchar(128)
  updated_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Table investigation.knowledge_chunks {
  id uuid [pk]
  document_id uuid [not null]
  chunk_index int [not null]
  content text [not null]
  embedding vector(1536)
  metadata jsonb
  created_at timestamp [not null, default: `now()`]

  indexes {
    (document_id, chunk_index) [unique]
  }
}

Ref: investigation.evidence.investigation_id > investigation.investigations.id
Ref: investigation.recommendations.investigation_id > investigation.investigations.id
Ref: investigation.knowledge_chunks.document_id > investigation.knowledge_documents.id


// =====================================================
// TABLE GROUPS (one per service DB schema)
// =====================================================

TableGroup control_service {
  control.users
  control.workspaces
  control.workspace_members
  control.projects
  control.project_api_keys
  control.project_settings
  control.releases
  control.deployments
}

TableGroup processing_service {
  processing.issues
  processing.error_events
  processing.metric_buckets
  processing.processed_batches
  processing.regression_records
}

TableGroup alerting_service {
  alerting.alert_rules
  alerting.alert_states
  alerting.alerts
  alerting.notification_channels
  alerting.alert_rule_channels
  alerting.deliveries
  alerting.delivery_attempts
}

TableGroup incident_service {
  incidents.incidents
  incidents.incident_issues
  incidents.incident_alerts
  incidents.incident_timeline
}

TableGroup investigation_service {
  investigation.investigations
  investigation.evidence
  investigation.recommendations
  investigation.knowledge_documents
  investigation.knowledge_chunks
}