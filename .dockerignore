# Python virtual environments
.venv/
*/.venv/
**/.venv/

# Node
node_modules/
frontend/.next/
frontend/out/

# Git
.git/
.gitignore

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/*.egg-info/
**/build/
**/dist/

# Env files (keep examples)
**/.env
**/.env.*
!**/.env.example

# Keys (mounted as volumes at runtime)
services/*/keys/

# Misc
**/.DS_Store
**/*.log
