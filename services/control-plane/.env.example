CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://faultline:faultline@localhost:5432/control_plane
CONTROL_PLANE_LOG_LEVEL=INFO
CONTROL_PLANE_JWT_PRIVATE_KEY_PATH=keys/private.pem
CONTROL_PLANE_JWT_PUBLIC_KEY_PATH=keys/public.pem
CONTROL_PLANE_JWT_KEY_ID=dev-1
CONTROL_PLANE_JWT_ISSUER=faultline-control-plane
CONTROL_PLANE_JWT_AUDIENCE=faultline
CONTROL_PLANE_ACCESS_TOKEN_TTL_MINUTES=15
CONTROL_PLANE_REFRESH_TOKEN_TTL_DAYS=7
CONTROL_PLANE_JWKS_CACHE_MAX_AGE_SECONDS=300

# Internal service-to-service secret (must match Ingestion's secret)
# Generate with: openssl rand -hex 32
CONTROL_PLANE_INTERNAL_SERVICE_SECRET=change-me

