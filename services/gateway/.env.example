# API Gateway Environment Configuration

# ── Upstream Services ─────────────────────────────────────────────────────────
GATEWAY_UPSTREAM_CONTROL_PLANE_URL=http://control-plane:8000
GATEWAY_UPSTREAM_INGESTION_URL=http://ingestion:8001
GATEWAY_UPSTREAM_PROCESSING_URL=http://processing-api:8002

# Future services (disabled by default)
GATEWAY_UPSTREAM_ALERTING_URL=http://alerting:8003
GATEWAY_UPSTREAM_INCIDENT_URL=http://incident:8004
GATEWAY_UPSTREAM_INVESTIGATION_URL=http://investigation:8005
GATEWAY_ENABLE_ALERTING=false
GATEWAY_ENABLE_INCIDENT=false
GATEWAY_ENABLE_INVESTIGATION=false

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_STRATEGY=auto
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_REDIS_TIMEOUT_SECONDS=2.0

# ── Timeouts & Limits ─────────────────────────────────────────────────────────
GATEWAY_CONNECT_TIMEOUT_SECONDS=3.0
GATEWAY_READ_TIMEOUT_SECONDS=30.0
GATEWAY_INGESTION_READ_TIMEOUT_SECONDS=30.0
GATEWAY_MAX_REQUEST_BODY_BYTES=5242880
GATEWAY_TRUST_FORWARDED_FOR=false

# ── Connection Pool ───────────────────────────────────────────────────────────
GATEWAY_POOL_MAX_CONNECTIONS=100
GATEWAY_POOL_MAX_KEEPALIVE_CONNECTIONS=20

# ── Logging ───────────────────────────────────────────────────────────────────
GATEWAY_LOG_LEVEL=INFO

