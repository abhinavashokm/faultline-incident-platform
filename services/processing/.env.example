# Faultline Processing Service Configuration

# Database
PROCESSING_DATABASE_URL=postgresql+asyncpg://faultline:faultline@localhost:5432/processing
PROCESSING_DATABASE_SCHEMA=processing

# Kafka
PROCESSING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PROCESSING_ERROR_EVENTS_TOPIC=error-events
PROCESSING_ERRORS_CONSUMER_GROUP=processing-errors

# Retries and Backpressure
PROCESSING_MAX_RETRIES=3
PROCESSING_BACKOFF_BASE=0.5
PROCESSING_BACKOFF_CAP=10.0
PROCESSING_CONTEXT_BYTE_CAP=16384

# Logging
PROCESSING_LOG_LEVEL=INFO

# Authentication & JWT Verification (faultline-auth)
AUTH_PROVIDER=static
AUTH_ISSUER=faultline-control-plane
AUTH_AUDIENCE=faultline
AUTH_LEEWAY_SECONDS=30
AUTH_PUBLIC_KEY_PATH=keys/public.pem
AUTH_JWT_KEY_ID=dev-1
AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_REFETCH_COOLDOWN_SECONDS=30
AUTH_JWKS_TIMEOUT_SECONDS=3.0


