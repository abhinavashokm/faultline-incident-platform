# Faultline Processing Service Configuration

# Database
PROCESSING_DATABASE_URL=postgresql+asyncpg://faultline:faultline@localhost:5432/processing
PROCESSING_DATABASE_SCHEMA=processing

# Kafka
PROCESSING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PROCESSING_ERROR_EVENTS_TOPIC=error-events
PROCESSING_ERRORS_CONSUMER_GROUP=processing-errors

# Retries and Backpressure
PROCESSING_MAX_RETRIES=3
PROCESSING_BACKOFF_BASE=0.5
PROCESSING_BACKOFF_CAP=10.0
PROCESSING_CONTEXT_BYTE_CAP=16384

# Logging
PROCESSING_LOG_LEVEL=INFO

# Authentication & JWT Verification (Phase 2 & Phase 3)
PROCESSING_AUTH_PROVIDER=static
PROCESSING_AUTH_ISSUER=faultline-control-plane
PROCESSING_AUTH_AUDIENCE=faultline
PROCESSING_AUTH_LEEWAY_SECONDS=30
PROCESSING_AUTH_PUBLIC_KEY_PATH=keys/public.pem
PROCESSING_AUTH_JWT_KEY_ID=dev-1
PROCESSING_AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
PROCESSING_AUTH_JWKS_CACHE_TTL_SECONDS=300
PROCESSING_AUTH_JWKS_REFETCH_COOLDOWN_SECONDS=30
PROCESSING_AUTH_JWKS_TIMEOUT_SECONDS=3.0


