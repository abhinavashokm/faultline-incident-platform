# Alerting service configuration
ALERTING_DATABASE_URL=postgresql+asyncpg://faultline:faultline@localhost:5432/alerting
ALERTING_DATABASE_SCHEMA=alerting
ALERTING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALERTING_ISSUE_EVENTS_TOPIC=issue-events
ALERTING_REGRESSION_EVENTS_TOPIC=regression-events
ALERTING_CONSUMER_GROUP=alerting-alerts
AUTH_PROVIDER=jwks
AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
AUTH_ISSUER=faultline-control-plane
AUTH_AUDIENCE=faultline
ROLE=alerts
LOG_LEVEL=INFO

# SMTP (Mailpit in local dev)
ALERTING_SMTP_HOST=localhost
ALERTING_SMTP_PORT=1025
ALERTING_SMTP_USERNAME=
ALERTING_SMTP_PASSWORD=
ALERTING_SMTP_USE_TLS=false
ALERTING_EMAIL_FROM=no-reply@faultline.local
