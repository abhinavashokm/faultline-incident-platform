# Faultline Ingestion Service Configuration

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ERROR_EVENTS=error-events
KAFKA_PRODUCER_TIMEOUT_SECONDS=3.0
KAFKA_COMPRESSION_TYPE=gzip

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0

# Rate Limiting (per-project)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Control Plane Key Resolution
CONTROL_PLANE_INTERNAL_URL=http://localhost:8000
CONTROL_PLANE_SERVICE_TOKEN=change-me-internal-service-token
CONTROL_PLANE_TIMEOUT_SECONDS=2.0

# Key Caching
KEY_CACHE_TTL_SECONDS=300
KEY_NEGATIVE_CACHE_TTL_SECONDS=60

# Payload Limits and Concurrency
MAX_REQUEST_BODY_BYTES=204800
MAX_STACK_FRAMES=100
MAX_CONTEXT_BYTES=65536
MAX_IN_FLIGHT_PUBLISHES=100

# Logging
LOG_LEVEL=INFO

